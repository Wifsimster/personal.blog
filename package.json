{
  "name": "wifsimster-blog",
  "version": "1.37.5",
  "description": "Blog personnel",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build": "node scripts/optimize-images.mjs && astro build && node scripts/generate-og.mjs && node scripts/generate-rss.mjs && node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "typecheck": "tsrs --noEmit",
    "lint": "OXLINT_TSGOLINT_PATH=\"$(tsrslint-path)\" oxlint --type-aware",
    "docker:build": "docker build -t wifsimster/wifsimster-blog .",
    "docker:run": "docker run -p 8080:80 wifsimster/wifsimster-blog",
    "docker:publish": "docker build -t wifsimster/wifsimster-blog:latest . && docker push wifsimster/wifsimster-blog:latest"
  },
  "keywords": [
    "blog",
    "diy"
  ],
  "author": "Wifsimster",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.3.1",
    "primeicons": "^7.0.0"
  },
  "devDependencies": {
    "@maschwenk/tsrslint": "0.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "astro": "^7.4.2",
    "jsdom": "^30.1.3",
    "oxlint": "1.89.0",
    "satori": "^0.12.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
