---
import TagView from '@/views/TagView.astro'
import { postRegistry } from '@/posts'

export function getStaticPaths() {
  const tags = new Set(Object.values(postRegistry).flatMap((info) => info.metadata.tags || []))
  return [...tags].map((tag) => ({ params: { tag } }))
}

const { tag } = Astro.params
---
<TagView lang="en" tag={tag!} />
