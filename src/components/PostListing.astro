---
import PostList from '@/components/PostList.astro'
import { groupByYear, filterTags } from '@/lib/listing'
import { langPrefix, t } from '@/lib/i18n'
import { getAllTags } from '@/posts'
import type { Post } from '@/lib/posts'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
  posts: Post[]
  currentTag?: string
}

const { lang, posts, currentTag } = Astro.props
const tagCounts = getAllTags()
const availableTags = filterTags()
const years = groupByYear(posts)
const pill = 'shrink-0 whitespace-nowrap px-3 py-1.5 text-sm rounded-full transition-colors focus-ring'
const pillIdle = 'bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-zinc-300 hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300'
const pillActive = 'bg-primary-600 dark:bg-primary-500 text-white'
---
<section
  class="mb-16"
  data-listing
  data-lang={lang}
  data-mode={currentTag ? 'tag' : 'home'}
  data-count-one={t(lang, 'home.postsCount')}
  data-count-many={t(lang, 'home.postsCountPlural')}
  data-pill-idle={pillIdle}
  data-pill-active={pillActive}
>
  <div class="mb-6">
    <div class="relative">
      <input
        type="text"
        data-listing-search
        placeholder={t(lang, 'home.searchPlaceholderCount', { count: String(posts.length) })}
        class="w-full px-4 py-2 text-sm border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 text-gray-900 dark:text-zinc-100 placeholder-gray-500 dark:placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:focus:ring-primary-400 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-zinc-900 pr-10"
      />
      <div data-listing-count hidden class="absolute right-3 top-1/2 transform -translate-y-1/2 text-sm text-gray-400 dark:text-zinc-500 pointer-events-none"></div>
      <button
        type="button"
        data-listing-clear-search
        hidden
        class="absolute right-3 top-1/2 transform -translate-y-1/2 rounded text-gray-500 dark:text-zinc-500 hover:text-gray-700 dark:hover:text-zinc-300 transition-colors focus-ring"
        aria-label="Clear search"
      >
        <i class="pi pi-times text-sm"></i>
      </button>
    </div>
  </div>

  <div class="mb-6">
    <div class="flex gap-2 flex-nowrap overflow-x-auto no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap sm:overflow-visible">
      {availableTags.map((tag) => currentTag ? (
        <a href={`${langPrefix(lang)}/tags/${encodeURIComponent(tag)}`} class:list={[pill, tag === currentTag ? pillActive : pillIdle]}>
          {tag} ({tagCounts[tag]})
        </a>
      ) : (
        <button type="button" data-tag-filter={tag} aria-pressed="false" class:list={[pill, pillIdle]}>
          {tag} ({tagCounts[tag]})
        </button>
      ))}
    </div>
  </div>

  <div data-listing-clear-filters hidden class="mb-6">
    <button
      type="button"
      class="px-4 py-2 text-sm rounded text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors focus-ring"
    >
      {t(lang, 'home.clearFilters')}
    </button>
  </div>

  <div data-listing-results class="space-y-10" hidden={posts.length === 0}>
    {years.map((group) => (
      <div data-year-group class="space-y-5">
        <h2 class="flex justify-between items-center text-2xl font-bold text-gray-900 dark:text-zinc-100 border-b border-gray-200 dark:border-zinc-800 pb-2">
          <span>{group.year}</span>
          <span data-year-count class="text-sm text-gray-500 dark:text-zinc-400 font-normal">({group.posts.length})</span>
        </h2>
        <PostList posts={group.posts} lang={lang} />
      </div>
    ))}
  </div>
  <div data-listing-empty class="text-center py-12 text-gray-500 dark:text-zinc-400" hidden={posts.length > 0}>
    {t(lang, 'home.noResults')}
  </div>
</section>

<script>
  import { initListing } from '@/scripts/listing'
  initListing()
</script>
