---
import FlagIcon from '@/components/FlagIcon.astro'
import { switchLanguagePath } from '@/lib/i18n'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
  path: string
  id: string
}

const { lang, path, id } = Astro.props
const label = lang === 'fr' ? 'Passer en anglais' : 'Switch to French'
---
<a
  href={switchLanguagePath(path, lang === 'fr' ? 'en' : 'fr')}
  class="w-8 h-8 rounded-full bg-gray-200 dark:bg-zinc-700 hover:bg-gray-300 dark:hover:bg-zinc-600 transition-colors flex items-center justify-center focus-ring text-gray-700 dark:text-zinc-300"
  aria-label={label}
  title={label}
>
  <FlagIcon lang={lang} id={id} class="w-5 h-5" />
</a>
