---
import { t } from '@/lib/i18n'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
}

const { lang } = Astro.props
const toDark = t(lang, 'theme.toDark')
const toLight = t(lang, 'theme.toLight')
---
<button
  type="button"
  data-theme-toggle
  data-label-dark={toDark}
  data-label-light={toLight}
  class="w-8 h-8 rounded-full bg-gray-200 dark:bg-zinc-700 hover:bg-gray-300 dark:hover:bg-zinc-600 transition-colors flex items-center justify-center focus-ring"
  aria-label={toDark}
>
  <span class="hidden dark:inline-flex" aria-hidden="true">
    <i class="pi pi-moon text-sm text-gray-700 dark:text-zinc-300"></i>
  </span>
  <span class="inline-flex dark:hidden" aria-hidden="true">
    <i class="pi pi-sun text-sm text-gray-700 dark:text-zinc-300"></i>
  </span>
</button>
