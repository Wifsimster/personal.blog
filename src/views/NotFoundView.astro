---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts } from '@/posts'
import { formatDate, sortPostsByDate } from '@/lib/posts'
import { homePath, t } from '@/lib/i18n'
import { SITE_NAME, SITE_URL, localPath } from '@/lib/seo'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
}

const { lang } = Astro.props
const host = new URL(SITE_URL).host
const latest = sortPostsByDate(getAllPosts(lang)).slice(0, 3)
---
<BaseLayout lang={lang} path={homePath(lang)} title={SITE_NAME} noindex>
  <div class="min-h-[60vh] flex items-center py-12">
    <div class="w-full max-w-2xl mx-auto">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400 mb-4">
        {t(lang, 'post.notFound.eyebrow')}
      </p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-zinc-100 mb-4">
        {t(lang, 'post.notFound.title')}
      </h1>
      <p class="text-lg text-gray-600 dark:text-zinc-400 mb-8">
        {t(lang, 'post.notFound.message')}
      </p>

      <div class="rounded-xl border border-gray-200 dark:border-zinc-700/70 bg-white/70 dark:bg-zinc-950/50 backdrop-blur-sm shadow-sm overflow-hidden mb-8">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-gray-200 dark:border-zinc-700/70" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-zinc-700"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-zinc-700"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-zinc-700"></span>
          <span class="ml-3 font-mono text-xs text-gray-500 dark:text-zinc-500">{host}</span>
        </div>
        <div class="px-4 py-4 font-mono text-sm leading-7 [overflow-wrap:anywhere]">
          <p class="text-gray-900 dark:text-zinc-100">
            <span class="text-primary-600 dark:text-primary-400 select-none">$ </span>curl -I {host}<span data-not-found-path>/…</span>
          </p>
          <p class="text-gray-900 dark:text-zinc-100">
            HTTP/2 <span class="font-semibold text-primary-600 dark:text-primary-400">404</span>
          </p>
          <p class="text-gray-500 dark:text-zinc-500">x-reason: {t(lang, 'post.notFound.reason')}</p>
          <p class="text-gray-500 dark:text-zinc-500">x-next: {t(lang, 'post.notFound.next')}</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mb-12">
        <a
          href={homePath(lang)}
          class="inline-flex items-center px-5 py-2.5 rounded-lg bg-primary-600 dark:bg-primary-500 text-white font-medium shadow-sm transition-colors hover:bg-primary-700 dark:hover:bg-primary-600 focus-ring"
        >
          {t(lang, 'post.notFound.backHome')}
        </a>
        <a
          href={localPath(lang, '/archives')}
          class="inline-flex items-center px-5 py-2.5 rounded-lg border border-gray-300 dark:border-zinc-700 text-gray-900 dark:text-zinc-100 font-medium transition-colors hover:border-primary-500 hover:text-primary-600 dark:hover:border-primary-400 dark:hover:text-primary-400 focus-ring"
        >
          {t(lang, 'nav.archives')}
        </a>
      </div>

      {latest.length > 0 && (
        <section>
          <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-zinc-500 mb-3">
            {t(lang, 'post.notFound.latest')}
          </h2>
          <ul class="divide-y divide-gray-200 dark:divide-zinc-800 border-y border-gray-200 dark:border-zinc-800">
            {latest.map((post) => (
              <li>
                <a
                  href={localPath(lang, `/posts/${post.slug}`)}
                  class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 focus-ring"
                >
                  <span class="font-medium text-gray-900 dark:text-zinc-100 transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-400">
                    {post.title}
                  </span>
                  <span class="shrink-0 font-mono text-xs text-gray-500 dark:text-zinc-500">
                    {formatDate(post.date, lang)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  const target = document.querySelector('[data-not-found-path]')
  if (target) target.textContent = window.location.pathname
</script>
