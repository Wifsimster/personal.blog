---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostListing from '@/components/PostListing.astro'
import { getAllPosts } from '@/posts'
import { t } from '@/lib/i18n'
import { AUTHOR_NAME, SITE_NAME, SITE_URL, alternatesFor, localPath } from '@/lib/seo'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
}

const { lang } = Astro.props

const HOME_COPY = {
  fr: {
    title: 'Wifsimster Blog — DIY, domotique, électronique et rénovation',
    description: 'Blog personnel de Wifsimster : projets DIY, domotique (ESP8266, Raspberry Pi, Jeedom), électronique et rénovation de maison.'
  },
  en: {
    title: 'Wifsimster Blog — DIY, Home Automation, Electronics & Renovation',
    description: 'Personal blog by Wifsimster: DIY projects, home automation (ESP8266, Raspberry Pi, Jeedom), electronics, and house renovation.'
  }
}
const copy = HOME_COPY[lang]
const alternates = { fr: `${SITE_URL}/`, en: alternatesFor('/').en }
const homeUrl = lang === 'en' ? alternates.en : alternates.fr
const ogImage = `${SITE_URL}/images/og/default.png`
---
<BaseLayout
  lang={lang}
  path={localPath(lang, '/')}
  title={copy.title}
  description={copy.description}
  canonical={homeUrl}
  alternates={alternates}
  og={{ title: copy.title, description: copy.description, image: ogImage, url: homeUrl, type: 'website' }}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    inLanguage: lang,
    description: copy.description,
    publisher: { '@type': 'Person', name: AUTHOR_NAME, url: SITE_URL }
  }}
>
  <div>
    <!-- Introduction Section -->
    <section class="mb-4">
      <h1 class="text-5xl font-bold text-gray-900 dark:text-zinc-100 mb-4">
        {t(lang, 'home.introTitle')}
      </h1>
      <p class="text-lg text-gray-700 dark:text-zinc-300 mb-4 leading-relaxed">
        {t(lang, 'home.introText')}
      </p>
    </section>

    <!-- Blog Section -->
    <PostListing lang={lang} posts={getAllPosts(lang)} />
  </div>
</BaseLayout>
