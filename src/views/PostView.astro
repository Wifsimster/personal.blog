---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TagList from '@/components/TagList.astro'
import ImageGallery from '@/components/ImageGallery.astro'
import BackToTop from '@/components/BackToTop.astro'
import { getPostBySlug, isDraft, isScheduled } from '@/posts'
import { estimateReadingTime, formatDate, type Post } from '@/lib/posts'
import { relatedPosts } from '@/lib/listing'
import { renderPostHtml } from '@/lib/render'
import { langPrefix, t } from '@/lib/i18n'
import { AUTHOR_NAME, SITE_NAME, SITE_URL, pageTitle } from '@/lib/seo'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
  slug: string
}

const { lang, slug } = Astro.props
const info = getPostBySlug(slug)!
const content = info.getContent(lang)
const post: Post = {
  slug: info.metadata.slug,
  title: content.title,
  date: info.metadata.date,
  description: content.description,
  tags: info.metadata.tags,
  html: content.html,
  lang,
  draft: info.metadata.draft === true
}
const hidden = isDraft(info) || isScheduled(info)
const prefix = langPrefix(lang)
const rendered = renderPostHtml(post.html, lang)
const related = relatedPosts(post, lang)

const postUrl = `${SITE_URL}${prefix}/posts/${slug}`
const ogImage = `${SITE_URL}/images/og/${slug}-${lang}.png`
const alternates = {
  fr: info.getContent('fr').title ? `${SITE_URL}/posts/${slug}` : undefined,
  en: info.getContent('en').title ? `${SITE_URL}/en/posts/${slug}` : undefined
}
const head = hidden
  ? { noindex: true }
  : {
      canonical: postUrl,
      alternates,
      og: { title: post.title, description: post.description || '', image: ogImage, url: postUrl, type: 'article' as const },
      jsonLd: {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: post.title,
        description: post.description || '',
        image: ogImage,
        url: postUrl,
        datePublished: post.date || undefined,
        dateModified: post.date || undefined,
        inLanguage: lang,
        keywords: (post.tags || []).join(', '),
        author: { '@type': 'Person', name: AUTHOR_NAME, url: SITE_URL },
        publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
        mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl }
      }
    }
const titlePrefix = post.draft ? `[${t(lang, 'post.draft.badge')}] ` : ''
---
<BaseLayout
  lang={lang}
  path={`${prefix}/posts/${slug}`}
  title={pageTitle(`${titlePrefix}${post.title}`)}
  description={post.description || ''}
  headings={rendered.headings}
  {...head}
>
  <div>
    <div
      data-reading-progress
      class="fixed left-0 z-50 h-[3px] bg-primary-500 transition-all duration-150 ease-out top-[calc(3.5rem+env(safe-area-inset-top))] [[data-header-hidden=true]_&]:top-0 lg:top-0"
      style="width: 0%"
    ></div>

    <div data-post data-draft={String(post.draft)} data-title={post.title}>
      <div class="mb-6">
        <a
          href={`${prefix}/`}
          class="inline-flex items-center rounded text-sm text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors focus-ring"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t(lang, 'post.goBack')}
        </a>
      </div>
      {post.draft && (
        <div class="mb-6 flex items-start gap-3 rounded-lg border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/40 px-4 py-3">
          <svg class="w-5 h-5 mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <div>
            <p class="font-semibold text-amber-900 dark:text-amber-200">{t(lang, 'post.draft.title')}</p>
            <p class="text-sm text-amber-800 dark:text-amber-300/90">{t(lang, 'post.draft.notice')}</p>
          </div>
        </div>
      )}
      <article>
        <header class="mb-8">
          <h1 class="post-title text-gray-900 dark:text-zinc-100 mb-4">
            {post.title}
          </h1>
          {post.description && (
            <p class="text-xl text-gray-600 dark:text-zinc-400 mb-4 subtitle">
              {post.description}
            </p>
          )}
          <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-zinc-400 mb-4">
            <time datetime={post.date}>{formatDate(post.date, lang)}</time>
            <span class="text-gray-300 dark:text-zinc-600">|</span>
            <span>{t(lang, 'post.readingTime', { min: String(estimateReadingTime(post.html, lang)) })}</span>
          </div>
          {post.tags && post.tags.length > 0 && (
            <div class="mb-6">
              <TagList tags={post.tags} lang={lang} />
            </div>
          )}
        </header>
        <main>
          <section class="prose prose-lg dark:prose-invert max-w-none">
            <div class="post-content" set:html={rendered.html}></div>
          </section>
        </main>
      </article>

      {related.length > 0 && (
        <section class="mt-12 pt-8 border-t border-gray-200 dark:border-zinc-800">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-zinc-100 mb-6">
            {t(lang, 'post.relatedPosts')}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {related.map((p) => (
              <a
                href={`${prefix}/posts/${p.slug}`}
                class="block p-4 rounded-lg border border-gray-200 dark:border-zinc-700 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all bg-white dark:bg-zinc-800 focus-ring"
              >
                <h3 class="font-semibold text-gray-900 dark:text-zinc-100 mb-2 line-clamp-2">
                  {p.title}
                </h3>
                <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-zinc-400">
                  <time datetime={p.date}>{formatDate(p.date, lang)}</time>
                  <span>{t(lang, 'post.readingTime', { min: String(estimateReadingTime(p.html, lang)) })}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
    <ImageGallery />
    <BackToTop lang={lang} />
  </div>
</BaseLayout>

<script>
  import '@/scripts/post'
</script>
