---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostListing from '@/components/PostListing.astro'
import { getPostsByTag } from '@/posts'
import { t } from '@/lib/i18n'
import { alternatesFor, localPath, pageTitle } from '@/lib/seo'
import type { Language } from '@/types/i18n'

export interface Props {
  lang: Language
  tag: string
}

const { lang, tag } = Astro.props
const posts = getPostsByTag(tag, lang)
const count = posts.length
const pathWithoutLang = `/tags/${encodeURIComponent(tag)}`
const alternates = alternatesFor(pathWithoutLang)
---
<BaseLayout
  lang={lang}
  path={localPath(lang, pathWithoutLang)}
  title={pageTitle(`${t(lang, 'tags.title')}: ${tag}`)}
  canonical={alternates[lang]}
  alternates={alternates}
>
  <div>
    <!-- Introduction Section -->
    <section class="mb-4">
      <h1 class="text-5xl font-bold text-gray-900 dark:text-zinc-100 mb-4">
        {t(lang, 'tags.title')}: {tag}
      </h1>
      <p class="text-lg text-gray-700 dark:text-zinc-300 mb-4 leading-relaxed">
        {t(lang, count === 1 ? 'home.postsCount' : 'home.postsCountPlural', { count: String(count) })}
      </p>
    </section>

    <!-- Blog Section -->
    <PostListing lang={lang} posts={posts} currentTag={tag} />
  </div>
</BaseLayout>
