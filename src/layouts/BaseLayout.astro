---
import Head, { type Props as HeadProps } from '@/components/Head.astro'
import Sidebar from '@/components/Sidebar.astro'
import Header from '@/components/Header.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import type { Heading } from '@/lib/render'
import '@/styles/main.css'
import 'primeicons/primeicons.css'

export interface Props extends HeadProps {
  /** Current path, without trailing slash: drives the language switch and nav state. */
  path: string
  /** Set on article pages: the right-hand table of contents. */
  headings?: Heading[]
}

const { path, headings, ...head } = Astro.props
---
<!DOCTYPE html>
<html lang={head.lang}>
  <head>
    <Head {...head} />
  </head>
  <body>
    <div class="min-h-screen transition-colors duration-200">
      <div class="tech-spotlight" aria-hidden="true"></div>
      <div class="flex min-h-screen">
        <Sidebar lang={head.lang} path={path} />
        <div class="flex-1 flex flex-col min-w-0">
          <!-- Mobile Header (visible only below lg) -->
          <Header lang={head.lang} path={path} class="lg:hidden" />
          <main class="flex-1 p-6 md:p-8 2xl:p-12 max-w-4xl mx-auto w-full min-w-0">
            <slot />
          </main>
        </div>
        {headings && headings.length > 0 && <TableOfContents lang={head.lang} headings={headings} />}
      </div>
    </div>
    <script>
      import '@/scripts/site'
    </script>
  </body>
</html>
